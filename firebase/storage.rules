rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mirrors public Supabase buckets: anyone may read, only owner writes own folder.
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /marketplace/{file**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true
        && request.resource.size < 20 * 1024 * 1024;
    }
    // Announcement images: signed-in users may read; authenticated users may
    // write or delete only images under 2MB. The Firestore admin-only
    // announcement write rule remains the real gate: an orphan upload without
    // an announcement document can never surface in the app.
    match /announcements/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && resource.size < 2 * 1024 * 1024 && resource.contentType.matches('image/.*');
    }
    match /{all**} { allow read, write: if false; }
  }
}
