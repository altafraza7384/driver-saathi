rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Admin check: the custom claim (if ever set) OR the roles/{uid} doc
    // (the app's real admin source — the claim is never set by code).
    function isAdmin() {
      return request.auth != null && (request.auth.token.get('admin', false) == true
        || (firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.roles.hasAny(['admin'])));
    }
    // Mirrors public Supabase buckets: anyone may read, only owner writes own folder.
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /marketplace/{file=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 20 * 1024 * 1024;
    }
    match /{all=**} { allow read, write: if false; }
  }
}
