rules_version = '2';
// Data model: users/{uid}/{collection}/{docId}. uid == migrated Supabase user UUID.
// Server-only: roles, aiUsage, sentNotifications, appConfig (Admin SDK bypasses rules).
// Admin access: a user is an admin when they carry the Auth custom claim
// `admin: true` OR when a roles/{uid} document (created via the Firebase
// console — client writes to roles are denied by design) lists "admin" in
// its `roles` array. The console-granted roles doc is how the in-app admin
// panel is activated.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && (request.auth.token.get('admin', false) == true
        || (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.roles.hasAny(['admin'])));
    }
    // Block enforcement (fail-closed, user decision 2026-10-24): a profile
    // flagged is_blocked by an admin is denied every data read/write
    // below EXCEPT reading their own users/{uid} profile doc — the app's
    // block gate reads exactly that doc to show the Blocked screen, and
    // the gate treats read errors as NOT blocked, so denying it would let
    // a blocked user straight into the app. A missing profile doc counts
    // as NOT blocked (signup creates the doc; a missing doc must never
    // lock a legitimate user out). Admin paths are NOT gated: an admin
    // must still read a blocked user to unblock them; a blocked admin is
    // unblocked via the other admin account or the console.
    function isBlocked() {
      // 2026-10-25: .data.is_blocked ERRORED ("Property is_blocked is
      // undefined") when the profile doc has no is_blocked field — which
      // is every profile today — and that error poisoned every &&-chain
      // using notBlocked(), denying plans reads outright (proven in the
      // Rules Playground). .get() with a default is null-safe: a missing
      // field counts as NOT blocked, which is the documented intent.
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('is_blocked', false) == true;
    }
    function notBlocked() { return !isBlocked(); }
    function ownsPayload(uid) {
      return !('user_id' in request.resource.data) || request.resource.data.user_id == uid;
    }

    match /users/{uid} {
      // Profile document. Admins may read any profile and update any field
      // (needed for block/unblock and plan assignment); owners may not touch
      // admin-managed fields, so a user can never unblock themselves or
      // grant themselves a plan.
      allow read: if isOwner(uid) || isAdmin();
      // create: the NEW document must not contain admin-managed fields.
      allow create: if (isOwner(uid) && notBlocked()
        && !request.resource.data.keys().hasAny(['role', 'roles', 'admin', 'is_blocked', 'subscription_plan_id']))
        || isAdmin();
      // update: only the CHANGED fields are checked (diff().affectedKeys()),
      // because the merged post-update document always contains fields the
      // admin assigned earlier (e.g. subscription_plan_id) — checking the
      // whole document locked plan-holding users out of their own profile.
      allow update: if (isOwner(uid) && notBlocked()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles', 'admin', 'is_blocked', 'subscription_plan_id']))
        || isAdmin();
      allow delete: if false; // deletion only via deleteAccount function

      function ownedCollections() {
        return ['transactions','debts','debt_payments','goals','notes','reminders',
                'car_checks','car_documents','health_logs','emergency_contacts',
                'platform_affiliations','push_subscriptions','chat_messages',
                'recurring_expenses','recurring_expense_payments','budgets'];
      }
      match /{collection}/{docId} {
        allow read, delete: if ((isOwner(uid) && notBlocked()) || isAdmin()) && collection in ownedCollections();
        allow create: if isOwner(uid) && notBlocked() && ownsPayload(uid) && collection in ownedCollections();
        // chat messages are append-only (matches previous policy: no UPDATE)
        allow update: if isOwner(uid) && notBlocked() && ownsPayload(uid)
          && collection in ownedCollections() && collection != 'chat_messages';
      }
      // aiUsage / sentNotifications fall through: denied for clients.
    }

    match /roles/{uid} { allow read: if (isOwner(uid) && notBlocked()) || isAdmin(); allow write: if false; }

    match /subscription_plans/{planId} {
      // Split read (2026-10-25): a single allow combining a per-document
      // field check with isAdmin() denied list queries (both filtered and
      // unfiltered) with permission-denied. Two allows keep the exact same
      // access: admins read all plans, other signed-in non-blocked users
      // read active plans only.
      allow read: if signedIn() && notBlocked() && isAdmin();
      allow read: if signedIn() && notBlocked() && resource.data.is_active == true;
      // Create/update keep the price checks; delete is separate because a
      // delete has no request.resource, so the price checks would deny it.
      allow create, update: if isAdmin()
        && request.resource.data.price_inr is number
        && ((request.resource.data.billing_interval == 'free' && request.resource.data.price_inr == 0)
          || (request.resource.data.billing_interval in ['monthly','yearly'] && request.resource.data.price_inr > 0));
      allow delete: if isAdmin();
    }

    // Admin-managed discount offers shown on the plans card.
    match /offers/{id} {
      allow read: if signedIn() && notBlocked();
      allow write: if isAdmin();
    }

    // Admin announcements (2026-10-22): in-app banner + popup for all
    // signed-in users; audience filtering (all vs non-subscribers) happens
    // client-side in AnnouncementBanner, never as a security boundary —
    // announcement content is public to signed-in users by design, so a
    // subscriber reading an offer is harmless. Only admins may create,
    // edit or delete. Closed-app push for these announcements is the
    // staged sendAnnouncementPush function (Blaze-gated, not deployed).
    match /announcements/{id} {
      allow read: if signedIn() && notBlocked();
      allow write: if isAdmin();
    }

    // Admin-managed app config (e.g. the mechanic strike limit).
    match /config/{docId} {
      allow read, write: if isAdmin();
    }

    // Insurance leads (Phase 1, 2026-10-22): PRIVATE by design. A user
    // creates only their own lead, and only with consent == true; a user
    // reads only their own leads; ONLY an admin may update status /
    // commission (a user must never mark their own lead converted or set
    // their own commission). Leads are never readable by other users and
    // never appear in a public marketplace post. Partner forwarding is
    // manual in Phase 1; an automated webhook comes after Blaze.
    match /insurance_leads/{id} {
      allow create: if signedIn() && notBlocked()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && !request.resource.data.keys().hasAny(['commission_amount', 'commission_note']);
      allow read: if signedIn()
        && ((resource.data.user_id == request.auth.uid && notBlocked()) || isAdmin());
      // update: only CHANGED fields are checked (diff().affectedKeys()) —
      // the merged document always contains user_id/phone/consent, so the
      // old whole-document check denied EVERY admin update (status and
      // commission could never be saved).
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['user_id', 'phone', 'consent']);
      allow delete: if false;
    }

    match /marketplace_categories/{id} { allow read: if signedIn() && notBlocked(); allow write: if isAdmin(); }
    match /marketplace_posts/{id} {
      allow read: if signedIn() && notBlocked();
      allow create: if isAdmin() && request.resource.data.created_by == request.auth.uid;
      allow update: if isAdmin() && request.resource.data.created_by == resource.data.created_by;
      allow delete: if isAdmin();
    }

    // Car SOS — public request doc carries NO phone number and NO exact
    // location (approx coords + geohash only). Any signed-in user may read
    // pending requests (mechanics list them); names/phones/exact location
    // live in sos_request_details, readable only by the driver and the
    // assigned mechanic. Admins may read every request for oversight.
    match /sos_requests/{requestId} {
      allow create: if signedIn() && notBlocked()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.status == 'pending'
        // The public doc must never carry phone/exact coords (audit
        // 2026-10-24 hardening; the app never writes them here).
        && !request.resource.data.keys().hasAny(['driverPhone', 'phone', 'exactLat', 'exactLng'])
        && request.resource.data.category in ['tyre', 'mechanic', 'battery', 'other'];
      allow read: if signedIn()
        && ((notBlocked()
          && (resource.data.driverId == request.auth.uid
            // Pending requests are visible only to registered mechanics
            // (hardening 2026-10-26: previously ANY signed-in user could
            // list stranded drivers' approx locations).
            || (resource.data.status == 'pending'
              && exists(/databases/$(database)/documents/mechanics/$(request.auth.uid)))
            // Assigned mechanic: without this branch an accepted job
            // vanished from the mechanic's Jobs page (audit 2026-10-24).
            || resource.data.mechanicId == request.auth.uid))
          || isAdmin());
      allow update: if signedIn() && notBlocked() && (
        // Driver: cancel or complete their own request.
        (resource.data.driverId == request.auth.uid
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status in ['cancelled', 'completed'])
        // Assigned mechanic: accept a pending request. A held mechanic is
        // blocked server-side (not just in the app UI); a missing status
        // field counts as not held (old mechanic docs have no status field).
        // Deliberately NOT applied to the onway/completed branch below: a
        // mechanic held mid-job must still finish the driver's job.
        || (resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.mechanicId == request.auth.uid
          && request.resource.data.driverId == resource.data.driverId
          && exists(/databases/$(database)/documents/mechanics/$(request.auth.uid))
          && get(/databases/$(database)/documents/mechanics/$(request.auth.uid)).data.get('status', '') != 'held')
        // Assigned mechanic: move the job forward.
        || (resource.data.mechanicId == request.auth.uid
          && request.resource.data.mechanicId == request.auth.uid
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.status in ['onway', 'completed'])
      );
      allow delete: if false;
    }

    match /sos_request_details/{requestId} {
      allow create: if signedIn() && notBlocked()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.requestId == requestId;
      // Driver reads own details; a mechanic reads them only after being
      // assigned (the mechanic app claims the doc right after accepting).
      // Admins read them for SOS oversight/disputes (audit 2026-10-24).
      allow read: if signedIn()
        && (((resource.data.driverId == request.auth.uid
          || resource.data.mechanicId == request.auth.uid) && notBlocked())
          || isAdmin());
      allow update: if signedIn() && notBlocked()
        && get(/databases/$(database)/documents/sos_requests/$(requestId)).data.get('mechanicId', '') == request.auth.uid
        && request.resource.data.mechanicId == request.auth.uid;
      allow delete: if false;
    }

    // Mechanic profiles (Mechanic Saathi app). A mechanic owns exactly one
    // doc, keyed by their Firebase Auth uid. Admin-managed fields
    // (status/warnings/hold info) are excluded from owner writes, so a
    // mechanic can never clear their own strikes or unhold themselves.
    match /mechanics/{mechanicId} {
      allow create: if signedIn() && notBlocked() && mechanicId == request.auth.uid
        && !request.resource.data.keys().hasAny(['status', 'warnings', 'warning_history', 'held_at', 'held_reason']);
      allow read: if signedIn() && ((mechanicId == request.auth.uid && notBlocked()) || isAdmin());
      // update: only CHANGED fields are checked (diff().affectedKeys()) —
      // the merged document of a held mechanic always contains status, so
      // the old whole-document check locked held mechanics out of ALL
      // profile edits, not just status changes.
      allow update: if (signedIn() && notBlocked() && mechanicId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'warnings', 'warning_history', 'held_at', 'held_reason']))
        || isAdmin();
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
