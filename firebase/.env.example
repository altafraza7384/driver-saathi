# Frontend (public) Firebase WEB app config — copy from Firebase console > Project settings >
# Your apps > Web app. Do NOT use values from google-services.json (that is the Android app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=driver-saathi-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=driver-saathi-app
VITE_FIREBASE_STORAGE_BUCKET=driver-saathi-app.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=282968056888
VITE_BACKEND=supabase   # switch to "firebase" only after migration is verified

# Server secrets — set with `firebase functions:secrets:set NAME`, never in frontend:
# GOOGLE_AI_API_KEY, CRON_SHARED_SECRET (optional), VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY

# Migration scripts only (run on owner's machine, never commit):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# SUPABASE_DB_URL=postgres://...   (direct DB export incl. auth.users password hashes)
